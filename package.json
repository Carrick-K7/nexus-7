{
  "name": "nexus",
  "version": "4.8.9",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-minimatch-brace-expansion.mjs",
    "prebuild": "node scripts/inject-git-log.js && tsx scripts/generate-symbiosis-study.ts",
    "dev": "next dev",
    "build": "next build",
    "db:migrate": "node scripts/migrate-experiments.mjs",
    "db:backup": "tsx scripts/backup-postgres.ts",
    "db:restore": "tsx scripts/restore-postgres.ts",
    "backup:crypt": "tsx scripts/crypt-symbiosis-backup.ts",
    "recovery:evidence": "tsx scripts/record-symbiosis-recovery-evidence.ts",
    "ops:recovery-drill": "tsx scripts/run-recovery-drill.ts",
    "ops:deployment-drill": "tsx scripts/run-deployment-drill.ts",
    "verify:deployment-contract": "tsx scripts/run-deployment-conformance.ts",
    "verify:operations": "tsx scripts/run-operational-acceptance.ts",
    "verify:city": "tsx scripts/run-city-verification.ts",
    "verify:diagnosis": "tsx scripts/run-diagnosis-verification.ts",
    "verify:planning": "tsx scripts/run-planning-verification.ts",
    "verify:outcomes": "tsx scripts/run-outcome-learning-verification.ts",
    "verify:participation": "tsx scripts/run-participation-verification.ts",
    "verify:closure": "tsx scripts/run-closed-loop-verification.ts",
    "verify:symbiosis": "tsx scripts/run-symbiosis-verification.ts",
    "verify:v45": "tsx scripts/run-v45-verification.ts",
    "verify:v46": "tsx scripts/run-v46-verification.ts",
    "bundle:v47": "tsx scripts/run-v47-replication.ts --write",
    "verify:v47": "tsx scripts/run-v47-replication.ts",
    "verify:v48": "vitest run src/symbiosis/trust.test.ts",
    "worker:clock": "tsx scripts/run-experiment-clock.ts",
    "worker:operations": "tsx scripts/run-operational-intelligence.ts",
    "worker:symbiosis": "tsx scripts/run-symbiosis-clock.ts",
    "verify:stress": "tsx scripts/run-long-horizon.ts",
    "verify:model": "tsx scripts/run-model-regression.ts",
    "verify:model:live": "tsx scripts/run-model-regression.ts --live",
    "evaluate:isolated": "tsx scripts/run-isolated-evaluation.ts",
    "evidence:generate": "tsx scripts/generate-ci-evidence.ts",
    "evidence:verify": "tsx scripts/verify-github-attestation.ts",
    "evidence:verify-remote": "tsx scripts/verify-remote-evidence.ts",
    "evidence:ingest-remote": "tsx scripts/ingest-remote-evidence.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run --no-file-parallelism src/experiments/postgres-repository.test.ts src/governance/access-governance-postgres.test.ts src/operations/intelligence-postgres.test.ts src/city/model-postgres.test.ts src/diagnosis/postgres.test.ts src/planning/postgres.test.ts src/outcomes/postgres.test.ts src/participation/postgres.test.ts src/closure/postgres.test.ts src/symbiosis/postgres.test.ts src/operations/postgres-backup.test.ts src/operations/recovery-drill.test.ts",
    "test:ui": "vitest --ui",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "check": "npm audit --audit-level=moderate && npm run lint -- --max-warnings=0 && npm run test:run && npm run verify:model && npm run verify:operations && npm run verify:deployment-contract && npm run verify:city && npm run verify:diagnosis && npm run verify:planning && npm run verify:outcomes && npm run verify:participation && npm run verify:closure && npm run verify:symbiosis && npm run verify:v45 && npm run verify:v46 && npm run verify:v47 && npm run verify:v48 && npm run test:e2e && npm run verify:stress",
    "check:release": "npm run check && npm run evaluate:isolated -- quality && npm run evidence:generate && npm run verify:closure"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.7.0",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "tsx": "^4.23.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.11",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "0.35.3",
    "brace-expansion": "5.0.8"
  }
}

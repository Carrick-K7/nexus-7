    "evidence:verify": "tsx scripts/verify-github-attestation.ts",
    "evidence:verify-remote": "tsx scripts/verify-remote-evidence.ts",
    "evidence:ingest-remote": "tsx scripts/ingest-remote-evidence.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run --no-file-parallelism src/experiments/postgres-repository.test.ts src/governance/access-governance-postgres.test.ts src/operations/intelligence-postgres.test.ts src/city/model-postgres.test.ts src/diagnosis/postgres.test.ts src/planning/postgres.test.ts src/outcomes/postgres.test.ts src/participation/postgres.test.ts src/closure/postgres.test.ts src/symbiosis/postgres.test.ts src/research/postgres.test.ts src/research/postgres-hypotheses.test.ts src/operations/postgres-backup.test.ts src/operations/recovery-drill.test.ts",
    "test:ui": "vitest --ui",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "precheck": "node vendor/braces/verify.mjs",
    "check": "npm audit --audit-level=moderate && npm run lint -- --max-warnings=0 && npm run test:run && npm run verify:model && npm run verify:operations && npm run verify:deployment-contract && npm run verify:city && npm run verify:diagnosis && npm run verify:planning && npm run verify:outcomes && npm run verify:participation && npm run verify:closure && npm run verify:symbiosis && npm run verify:v45 && npm run verify:v46 && npm run verify:v47 && npm run verify:v48 && npm run verify:research && npm run verify:discovery && npm run test:e2e && npm run verify:stress",
    "check:release": "npm run check && npm run evaluate:isolated -- quality && npm run evidence:generate && npm run verify:closure",
    "study:long-horizon": "tsx scripts/run-long-horizon-study.ts",
    "study:multi-season": "tsx scripts/run-multi-season-study.ts"

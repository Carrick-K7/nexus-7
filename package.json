  "dependencies": {
    "framer-motion": "^12.38.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.7.0",
    "next": "16.4.3",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "tsx": "^4.23.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "braces": "file:vendor/braces/fork.tgz",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.1.6",
    "vitest": "4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "0.35.5",
    "brace-expansion": "5.0.12",
    "braces": "$braces",
    "baseline-browser-mapping@^2.0.0": "2.11.0",
    "browserslist@^4.0.0": "4.28.7",
    "js-yaml@^4.0.0": "4.3.2",
    "source-map-js@^1.0.0": "1.2.2",
    "undici@^7.0.0": "7.29.1"
  }
}

DATABASE_URL=postgresql://nexus:nexus@127.0.0.1:5432/nexus
NEXUS_CRON_SECRET=replace-with-a-random-secret
NEXUS_CLOCK_INTERVAL_MS=1000
NEXUS_CLOCK_WORKER_ID=nexus-clock-1
# All-synthetic Symbiotic Shenzhen. One Turn is one simulated day; cadence is
# wall-clock scheduling only and can be accelerated because no real participant
# deadline exists.
SYMBIOSIS_SEASON_ID=symbiotic-shenzhen-season-2026-q3
SYMBIOSIS_SEED=symbiotic-shenzhen-2026-q3-seed
SYMBIOSIS_TURN_INTERVAL_MS=3600000
SYMBIOSIS_WORKER_ID=nexus7-symbiosis-1
SYMBIOSIS_COGNITIVE_PROVIDER=deterministic
SYMBIOSIS_MONTHLY_BUDGET_USD=300
SYMBIOSIS_MODEL_TIMEOUT_MS=12000
# Optional bounded live cognition. Leave unset for the supported deterministic
# production mode; the city never requires an external model to keep running.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Anonymous, read-only City Lens deployment. Mutating methods must also be
# rejected at the reverse proxy.
NEXUS_AUTH_MODE=public-observer
# Use OIDC or signed proxy mode only for a separate operator control plane.
NEXUS_OIDC_ISSUER=https://identity.example.com/
NEXUS_OIDC_AUDIENCE=nexus-7
NEXUS_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
NEXUS_OIDC_ROLE_CLAIM=roles
NEXUS_OIDC_WORKSPACE_CLAIM=workspace_id
NEXUS_OIDC_PRINCIPAL_TYPE_CLAIM=principal_type
NEXUS_OIDC_ROLE_MAP={"nexus-viewer":"viewer","nexus-operator":"operator","nexus-admin":"admin"}
# Optional replacement for the single-provider variables above. Each provider
# is selected by exact issuer, then independently verifies audience, signature,
# expiry, and required claims.
NEXUS_OIDC_PROVIDERS_JSON=[{"issuer":"https://identity.example.com/","audience":"nexus-7","jwksUrl":"https://identity.example.com/.well-known/jwks.json","roleClaim":"roles","roleMap":{"nexus-viewer":"viewer","nexus-operator":"operator","nexus-admin":"admin"}},{"issuer":"https://token.actions.githubusercontent.com","audience":"nexus-7","jwksUrl":"https://token.actions.githubusercontent.com/.well-known/jwks","staticWorkspaceId":"workspace-neo-angeles","staticPrincipalType":"service-account","requiredClaims":{"repository":"Carrick-K7/nexus-7"}}]
NEXUS_ORGANIZATION_ID=organization-nexus-7
NEXUS_ORGANIZATION_NAME=NEXUS-7 Autonomy Lab
NEXUS_BOOTSTRAP_ADMIN_SUBJECT=replace-with-initial-admin-subject
NEXUS_BOOTSTRAP_ADMIN_ISSUER=https://identity.example.com/
NEXUS_BOOTSTRAP_ADMIN_WORKSPACE=workspace-neo-angeles
# For a same-origin identity-aware proxy, use NEXUS_AUTH_MODE=proxy instead.
# The proxy must strip incoming x-nexus-auth-* headers, then inject freshly
# signed values bound to the request method and path.
NEXUS_PROXY_AUTH_SECRET=replace-with-at-least-32-random-characters
NEXUS_PROXY_ISSUER=nexus-identity-proxy
NEXUS_PROXY_MAX_SKEW_SECONDS=30
NEXUS_MODEL_PROVIDER=openai
OPENAI_API_KEY=replace-with-a-server-side-secret
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_INPUT_COST_PER_MILLION=1
OPENAI_OUTPUT_COST_PER_MILLION=6
NEXUS_MODEL_PROMPT_VERSION=prompt-1.2.0
NEXUS_MODEL_POLICY_VERSION=model-policy-1.2.0
NEXUS_MODEL_MAX_TOKENS=512
NEXUS_MODEL_MAX_COST_USD=0.05
NEXUS_MODEL_TIMEOUT_MS=8000
NEXUS_MODEL_REGRESSION_MAX_P95_MS=8000
NEXUS_MODEL_REGRESSION_MAX_TOTAL_COST_USD=0.25
NEXUS_MODEL_REGRESSION_MAX_AVERAGE_COST_USD=0.03
NEXUS_MODEL_REGRESSION_OUTPUT=public/data/model-regression.json
NEXUS_ATTESTATION_REPOSITORY=Carrick-K7/nexus-7
NEXUS_ATTESTATION_SIGNER_WORKFLOW=Carrick-K7/nexus-7/.github/workflows/ci.yml
# The verifier worker receives the private key; the application receives only
# the corresponding public key.
NEXUS_ATTESTATION_RECEIPT_PRIVATE_KEY_BASE64=base64-encoded-ed25519-private-key-pem
NEXUS_ATTESTATION_RECEIPT_PUBLIC_KEY_BASE64=base64-encoded-ed25519-public-key-pem
NEXUS_EVIDENCE_REPOSITORY=Carrick-K7/nexus-7
NEXUS_RELEASE_POLICY_PUBLIC_KEY_BASE64=base64-encoded-ed25519-policy-public-key-pem
NEXUS_REQUIRE_SIGNED_RELEASE_POLICY=true
NEXUS_DEPLOYMENT_ADAPTER=http
NEXUS_DEPLOYMENT_BASE_URL=https://deployment-control.example.com/v1
NEXUS_DEPLOYMENT_TOKEN=replace-with-a-server-side-deployment-token
NEXUS_CLOSURE_READ_RATE_LIMIT=120
NEXUS_CLOSURE_MUTATION_RATE_LIMIT=30
# v2 accepts external trust only when both values verify the exact clean
# commit and CI-evidence manifest.
NEXUS_V2_ATTESTATION_RECEIPT_BASE64=base64-encoded-signed-receipt-json
TEST_RESTORE_DATABASE_URL=postgresql://nexus:nexus@127.0.0.1:5432/nexus_restore
NEXUS_RECOVERY_POINT_OBJECTIVE_MS=60000
NEXUS_RECOVERY_TIME_OBJECTIVE_MS=120000
NEXUS_RECOVERY_DRILL_OUTPUT=.artifacts/recovery-drill.json
NEXUS_ROLLBACK_TIME_OBJECTIVE_MS=60000
NEXUS_DEPLOYMENT_DRILL_OUTPUT=.artifacts/deployment-rollback-drill.json
NEXUS_OPERATIONS_INTERVAL_MS=60000
NEXUS_OPERATIONS_WORKER_ID=nexus-operations-1
NEXUS_SLO_RAW_RETENTION_DAYS=90
NEXUS_OPERATIONAL_ACCEPTANCE_OUTPUT=.artifacts/operational-acceptance.json
NEXUS_DEPLOYMENT_CONFORMANCE_OUTPUT=.artifacts/deployment-controller-conformance.json
NEXUS_CITY_ACCEPTANCE_OUTPUT=.artifacts/city-model-acceptance.json
NEXUS_DIAGNOSIS_ACCEPTANCE_OUTPUT=.artifacts/diagnosis-acceptance.json
NEXUS_PLANNING_ACCEPTANCE_OUTPUT=.artifacts/planning-acceptance.json
NEXUS_OUTCOME_ACCEPTANCE_OUTPUT=.artifacts/outcome-learning-acceptance.json
NEXUS_PARTICIPATION_ACCEPTANCE_OUTPUT=.artifacts/participation-acceptance.json
